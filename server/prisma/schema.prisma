generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String        @id
  nickname  String
  wins      Int           @default(0)
  losses    Int           @default(0)
  games     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  matches   MatchPlayer[]
}

model Match {
  id         String        @id @default(cuid())
  mode       String
  roomCode   String
  winnerName String?
  createdAt  DateTime      @default(now())
  players    MatchPlayer[]
}

model MatchPlayer {
  id       String  @id @default(cuid())
  matchId  String
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  nickname String
  isBot    Boolean @default(false)
  score    Int     @default(0)
  delta    Int     @default(0)
  isWinner Boolean @default(false)
}
